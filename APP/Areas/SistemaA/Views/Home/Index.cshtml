@using CodeData_Connection.Services

@{
    Layout = CurrentLayout.Layout;
    ViewData["Title"] = "Leitores, Terminais e Impressoras térmicas";
}

<div class="container bg-light rounded-3">
    <div class="row">
        <div class="col m-lg-5">
            <div class="text-center">
                <h3 class="text-uppercase">Bem-vindo ao Sistema de Controle PLH (Patrimônio, Locação e Homologação)!</h3>
                <p>O Sistema de Controle PLH é uma solução completa para a gestão de ativos da sua empresa. Com ele, você poderá controlar o patrimônio, locações e homologações de forma eficiente e organizada.</p>
                <p>Principais funcionalidades:</p>
            </div>

            <div class="list-group-item">
                <ul>
                    <li>Controle de Patrimônio</li>
                    <li>Gerenciamento de Locações e Homologações</li>
                    <li>Visualização em Mapa</li>
                    <li>Armazenamento de Documentos</li>
                    <li>Filtro de Busca Avançado</li>
                    <li>Níveis de Acesso</li>
                    <li>Modo Escuro</li>
                    <li>Bloqueio de Tela</li>
                </ul>
            </div>

            <div class="justify-content-center text-center m-lg-5">
                <h4>MANUAL DO USUÁRIO</h4>
                <iframe src="~/uploads/csharp-language.pdf" style="width: 100%"; height="800px"></iframe>
                <a href="~/uploads/csharp-language.pdf" download="manual_plh.pdf" class="btn btn-primary">Baixar Manual</a>
            </div>
        </div>
    </div>
</div>