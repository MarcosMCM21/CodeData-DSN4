@using CodeData_Connection.Services
@model CodeData_Connection.Areas.SistemaA.Controllers.FormsSolicitacaoViewModel

@{
    Layout = CurrentLayout.Layout;

    ViewData["Title"] = ViewBag.TipoSolicitacao ? "Locação" : "Homologação";
}

<div class="container mt-5">
    <div class="row">
        <div class="col">
            <form asp-action="@ViewBag.Post" method="post">

                <!-- Forms Cliente -->
                <div class="card mb-3">
                    <div class="card-header">
                        @if (ViewBag.Post == "Cadastrar") {
                            if (ViewBag.TipoSolicitacao == true)
                            {
                                <h5>CADASTRAR LOCAÇÃO</h5>
                            }
                            else
                            {
                                <h5>CADASTRAR HOMOLOGAÇÃO</h5>
                            }
                        } else {
                            if (ViewBag.TipoSolicitacao == true)
                            {
                                <h5>EDITAR LOCAÇÃO</h5>
                            }
                            else
                            {
                                <h5>EDITAR HOMOLOGAÇÃO</h5>
                            }
                    }
                    </div>
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        @if (ViewBag.Post == "Editar")
                        {
                            <div class="form-group">
                                <label asp-for="Tipo" class="control-label"></label>
                                <select asp-for="Tipo" class="form-control" disabled>
                                    <option value="true">Locação</option>
                                    <option value="false">Homologação</option>
                                </select>
                                <span asp-validation-for="Tipo" class="text-danger"></span>
                            </div>
                        }
                        
                        <div class="form-group">
                            <label asp-for="NumeroContrato" class="control-label">Número do Contrato</label>
                            <input asp-for="NumeroContrato" class="form-control" />
                            <span asp-validation-for="NumeroContrato" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="DataInicio" class="control-label">Data de Início</label>
                            <input asp-for="DataInicio" class="form-control" />
                            <span asp-validation-for="DataInicio" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="DataFinal" class="control-label">Data Final</label>
                            <input asp-for="DataFinal" class="form-control" />
                            <span asp-validation-for="DataFinal" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Forms Documento -->
                <div class="card mb-3">
                    <div class="card-header"><h5>DOCUMENTO</h5></div>
                    <div class="card-body">
                        <div class="form-group">
                            <label asp-for="DocumentoId" class="control-label">Documento</label>
                            <select asp-for="DocumentoId" id="documentos" class="form-control" />
                                <option value="">Selecionar Documento</option>
                                <option value="0">Novo documento</option>
                                @foreach (var documentos in ViewBag.Documentos)
                                {
                                    <option value="@documentos.Id">@documentos.Numero</option>
                                }
                            </select>
                            <span asp-validation-for="DocumentoId" class="text-danger"></span>
                        </div>

                        <div id="formsDoc" style="display: none">
                            <div class="form-group">
                                <label asp-for="NumeroDocumento" class="control-label">Número</label>
                                <input asp-for="NumeroDocumento" class="form-control" />
                                <span asp-validation-for="NumeroDocumento" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="NomeDocumento" class="control-label">Nome</label>
                                <input asp-for="NomeDocumento" class="form-control" />
                                <span asp-validation-for="NomeDocumento" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="TipoDocumento" class="control-label">Tipo</label>
                                <input asp-for="TipoDocumento" class="form-control" />
                                <span asp-validation-for="TipoDocumento" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Anexo" class="control-label"></label>
                                <input asp-for="Anexo" type="file" class="form-control" accept=".doc,.docx,.pdf" />
                                <span asp-validation-for="Anexo" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Forms Usuário -->
                <div class="card mb-3">
                    <div class="card-header"><h5>USUÁRIO RESPONSÁVEL</h5></div>
                    <div class="card-body">
                        <div class="form-group">
                            <label asp-for="UserId" class="control-label">Usuário</label>
                            <select asp-for="UserId" class="form-control" />
                                <option value="">Selecionar Vendedor</option>
                                @foreach (var vendedor in ViewBag.Vendedores)
                                {
                                    <option value="@vendedor.Id">@vendedor.Email</option>
                                }
                            </select>
                            <span asp-validation-for="UserId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Forms Cliente -->
                <div class="card mb-3">
                    <div class="card-header"><h5>CLIENTE</h5></div>
                    <div class="card-body">
                        <input type="hidden" asp-for="ClienteId" />

                        <div class="form-group">
                            <label asp-for="ClienteId" class="control-label">Cliente</label>
                            <select asp-for="ClienteId" class="form-control">
                                <option value="">Selecionar Cliente</option>
                                @foreach (var cliente in ViewBag.Clientes)
                                {
                                    <option value="@cliente.Id">@cliente.Nome</option>
                                }
                            </select>
                            <span asp-validation-for="ClienteId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Forms Endereço -->
                <div class="card mb-3">
                    <div class="card-header"><h5>ENDEREÇO</h5></div>
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="EnderecoId" />

                        <label for="sEndereco" class="control-label">Selecionar Endereço</label>
                        <select id="sEndereco" class="form-control">
                            <option value="">Selecionar Endereço</option>
                            <option value="0">Novo Endereço</option>
                            <option value="1">Endereço do cliente</option>
                        </select>

                        <div id="formsEndereco" style="display: none">
                            <div class="form-group">
                                <label asp-for="CEP" class="control-label"></label>
                                <input asp-for="CEP" class="form-control" id="cep" />
                                <span asp-validation-for="CEP" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Rua" class="control-label"></label>
                                <input asp-for="Rua" class="form-control" id="rua" />
                                <span asp-validation-for="Rua" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Numero" class="control-label">Número</label>
                                <input asp-for="Numero" class="form-control" />
                                <span asp-validation-for="Numero" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Bairro" class="control-label"></label>
                                <input asp-for="Bairro" class="form-control" id="bairro" />
                                <span asp-validation-for="Bairro" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Cidade" class="control-label"></label>
                                <input asp-for="Cidade" class="form-control" id="cidade" />
                                <span asp-validation-for="Cidade" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Estado" class="control-label"></label>
                                <input asp-for="Estado" class="form-control" id="estado" />
                                <span asp-validation-for="Estado" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Complemento" class="control-label"></label>
                                <input asp-for="Complemento" class="form-control" />
                                <span asp-validation-for="Complemento" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <input type="hidden" id="EquipamentosID" name="listaEquipamentos" />

                @await Html.PartialAsync("~/Views/Components/_TabelaEquipamentoSolicitacao.cshtml", Model.Equipamentos);

                <button type="submit" class="btn btn-primary">Salvar</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        window.addEventListener('load', ()=>{
            let cep = document.getElementById('cep')

            cep.addEventListener('change', ()=>{
                let cepValue = cep.value.replace("-", "")

                let rua = document.getElementById('rua')
                let bairro = document.getElementById('bairro')
                let cidade = document.getElementById('cidade')
                let estado = document.getElementById('estado')

                fetch(`https://brasilapi.com.br/api/cep/v1/${cepValue}`)
                    .then(data => data.json())
                    .then(data =>
                        {
                            console.log(data)
                            rua.value = data.street
                            bairro.value = data.neighborhood
                            cidade.value = data.city
                            estado.value = data.state

                        })
            })

            let doc = document.getElementById('documentos')
            let formsDoc = document.getElementById('formsDoc')
            let sEndereco = document.getElementById('sEndereco')
            let formsEndereco = document.getElementById('formsEndereco')

            doc.addEventListener('change', () => {
                if (doc.value == "0") {
                    formsDoc.style.display = 'block'
                } else {
                    formsDoc.style.display = 'none'
                }
            })

            sEndereco.addEventListener('change', () => {
                if (sEndereco.value == "0") {
                    formsEndereco.style.display = 'block'
                } else {
                    formsEndereco.style.display = 'none'
                }
            })
        })

        document.addEventListener('mousemove', function () {
            let equi = document.getElementById('EquipamentosID')
            let equipamentos = tableEquipamento.rows('.selected').data()
            let length = tableEquipamento.rows('.selected').data().length
            let listID = [];
            equi.value = "";

            for(let i = 0; i <= length; i++){
                if(equipamentos[i] != undefined){
                    listID.push(equipamentos[i][1])
                }
            }

            for(let i = 0; i < listID.length; i++){

                if (i == listID.length - 1){
                    equi.value = equi.value + listID[i]
                } else {
                    equi.value = equi.value + listID[i] + ","
                }

                console.log(equi.value)
                
            }
        });
    </script>
}