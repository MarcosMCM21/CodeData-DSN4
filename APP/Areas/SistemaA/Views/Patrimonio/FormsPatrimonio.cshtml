@using CodeData_Connection.Controllers

@model CodeData_Connection.Areas.SistemaA.Controllers.FormsEquipamentoViewModel

@{
    ViewData["Title"] = "Patrimônio";
}

<div class="container mt-5">
    <div class="row">
        <div class="col">

            <div class="card mb-3">
                <div class="card-header">
                    @if (ViewBag.Post == "Cadastrar")
                    {
                        <h5>CADASTRAR PATRIMÔNIO</h5>
                    }
                    else
                    {
                        <h5>EDITAR PATRIMÔNIO</h5>
                    }
                </div>
                <div class="card-body">
                    <form asp-action="@ViewBag.Post" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group">
                            <label asp-for="Codigo" class="control-label">Código</label>
                            <input asp-for="Codigo" class="form-control" />
                            <span asp-validation-for="Codigo" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Modelo" class="control-label"></label>
                            <input asp-for="Modelo" class="form-control" />
                            <span asp-validation-for="Modelo" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Descricao" class="control-label">Descrição</label>
                            <textarea asp-for="Descricao" class="form-control"></textarea>
                            <span asp-validation-for="Descricao" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Marca" class="control-label"></label>
                            <input asp-for="Marca" class="form-control" />
                            <span asp-validation-for="Marca" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="SerialNumber" class="control-label">Serial Number</label>
                            <input asp-for="SerialNumber" class="form-control" />
                            <span asp-validation-for="SerialNumber" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="PartNumber" class="control-label">Part Number</label>
                            <input asp-for="PartNumber" class="form-control" />
                            <span asp-validation-for="PartNumber" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Condicao" class="control-label">Condição</label>
                            <select asp-for="Condicao" class="form-control">
                                <option value="true">Ativo</option>
                                <option value="false">Inativo</option>
                            </select>
                            <span asp-validation-for="Condicao" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="EstoqueId" class="control-label">Estoques</label>
                            <select asp-for="EstoqueId" class="form-control">
                                <option value="">Selecione um estoque</option>
                                @foreach (var estoque in ViewBag.Estoques)
                                {
                                    <option value="@estoque.Id">@estoque.Nome</option>
                                }
                            </select>
                            <span asp-validation-for="EstoqueId" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="DocumentoId" class="control-label">Documentos</label>
                            <select asp-for="DocumentoId" id="documentos" class="form-control">
                                <option value="">Selecione um documento</option>
                                <option value="0">Novo documento</option>
                                @foreach (var documento in ViewBag.Documentos)
                                {
                                    <option value="@documento.Id">@documento.Nome</option>
                                }
                            </select>
                            <span asp-validation-for="DocumentoId" class="text-danger"></span>
                        </div>

                        <div id="formsDoc" style="display: none">
                            <div class="form-group">
                                <label asp-for="Numero" class="control-label">Número</label>
                                <input asp-for="Numero" class="form-control" />
                                <span asp-validation-for="Numero" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Nome" class="control-label"></label>
                                <input asp-for="Nome" class="form-control" />
                                <span asp-validation-for="Nome" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Tipo" class="control-label"></label>
                                <input asp-for="Tipo" class="form-control" />
                                <span asp-validation-for="Tipo" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Anexo" class="control-label"></label>
                                <input asp-for="Anexo" type="file" class="form-control" accept=".doc,.docx,.pdf" />
                                <span asp-validation-for="Anexo" class="text-danger"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary mt-3">Salvar</button>
                    </form>
                </div>
        </div>
    </div>
</div>




@section Scripts {
    <script>
        window.addEventListener('load', () => {
            let doc = document.getElementById('documentos')
            let formsDoc = document.getElementById('formsDoc')

            doc.addEventListener('change', () => {
                if (doc.value == "0") {
                    formsDoc.style.display = 'block'
                } else {
                    formsDoc.style.display = 'none'
                }
            })
        })
    </script>

    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
